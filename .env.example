# Supabase Configuration
# Optional: The portfolio operates in zero-config offline/local mode if omitted.
# When provided, certificates persist to your remote PostgreSQL table and Supabase storage bucket.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API
# Optional: Enhances the Recruiter Assistant and AI Certificate Scanner with live Gemini Vision.
VITE_GEMINI_API_KEY=your-gemini-api-key
