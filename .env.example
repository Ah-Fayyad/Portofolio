# Supabase Configuration
# Optional: The portfolio operates in zero-config offline/local mode if omitted.
# When provided, certificates persist to your remote PostgreSQL table and Supabase storage bucket.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Administrator passcode for the local dashboard fallback.
VITE_ADMIN_PASSCODE=Ahmed@2026

# Google Gemini API (server-only; never prefix this variable with VITE_)
# Optional: Enables the AI Certificate Scanner through the Vercel API.
GEMINI_API_KEY=your-gemini-api-key
