# Required: Public frontend credentials. Never use a Supabase service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API (server-only; never prefix this variable with VITE_)
# Optional: Enables the AI Certificate Scanner through the Vercel API.
GEMINI_API_KEY=your-gemini-api-key
